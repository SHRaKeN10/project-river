// Project River - database schema.
// Phase 1 establishes the auth + audit core. Phase 2 adds email verification /
// password reset tokens and links RefreshToken to Session (rotation family).
// Poker tables, hands, hand events and player statistics are added in Phase 5.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  PLAYER
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  BANNED
  DELETED
}

enum VerificationPurpose {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

enum PokerGameType {
  NLHE
}

enum PokerTableStatus {
  ACTIVE
  PAUSED
  CLOSED
}

model User {
  id             String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email          String     @unique
  username       String     @unique
  passwordHash   String
  role           UserRole   @default(PLAYER)
  status         UserStatus @default(ACTIVE)
  avatarUrl      String?
  emailVerifiedAt DateTime?
  /// Free-to-play game currency. NOT money - no deposits/withdrawals. Refills
  /// via /api/chips/rebuy when depleted.
  playChips      Int        @default(10000)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  deletedAt      DateTime?

  sessions             Session[]
  refreshTokens        RefreshToken[]
  verificationTokens   VerificationToken[]
  auditLogs            AuditLog[]          @relation("AuditActor")
  tableSeats           PokerTableSeat[]

  @@index([status])
}

/// A cash-game table. The live hand state lives in memory in the table's
/// TableRunner; this row is the durable config + current seat/stack roster
/// (written back after every hand) so a table survives an API restart.
model PokerTable {
  id         String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name       String
  gameType   PokerGameType    @default(NLHE)
  smallBlind Int
  bigBlind   Int
  ante       Int              @default(0)
  maxSeats   Int              @default(9)
  minBuyIn   Int
  maxBuyIn   Int
  isPrivate  Boolean          @default(false)
  status     PokerTableStatus @default(ACTIVE)
  handNumber Int              @default(0)
  buttonSeat Int?
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  seats PokerTableSeat[]

  @@index([status])
}

model PokerTableSeat {
  id         String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tableId    String      @db.Uuid
  table      PokerTable  @relation(fields: [tableId], references: [id], onDelete: Cascade)
  seatNumber Int
  userId     String?     @db.Uuid
  user       User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  stack      Int         @default(0)
  sittingOut Boolean     @default(false)
  joinedAt   DateTime?
  updatedAt  DateTime    @updatedAt

  @@unique([tableId, seatNumber])
  @@index([userId])
}

/// A device/browser login. Refresh tokens are grouped under a session (their
/// "rotation family"); revoking a session revokes every refresh token issued
/// under it. This is what "logout" and a future "log out other devices" act on.
model Session {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String    @db.Uuid
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  deviceId   String?
  userAgent  String?
  ip         String?
  lastSeenAt DateTime  @default(now())
  createdAt  DateTime  @default(now())
  revokedAt  DateTime?

  refreshTokens RefreshToken[]

  @@index([userId])
}

/// Opaque, single-use, rotated on every refresh. `tokenHash` is SHA-256 of the
/// raw token (the token itself carries 256 bits of entropy, so a slow hash
/// isn't needed here - unlike passwords). Presenting an already-revoked token
/// is treated as token theft: the whole session is revoked (see AuthService).
model RefreshToken {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId       String    @db.Uuid
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionId    String    @db.Uuid
  session      Session   @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  tokenHash    String    @unique
  expiresAt    DateTime
  revokedAt    DateTime?
  replacedById String?   @db.Uuid
  userAgent    String?
  ip           String?
  createdAt    DateTime  @default(now())

  @@index([userId])
  @@index([sessionId])
}

/// Single-use tokens for email verification and password reset. Same
/// hashed-opaque-token pattern as RefreshToken. No email is sent yet in
/// Phase 2 (see AuthService) - this models the storage/consumption side.
model VerificationToken {
  id          String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String              @db.Uuid
  user        User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  purpose     VerificationPurpose
  tokenHash   String              @unique
  expiresAt   DateTime
  consumedAt  DateTime?
  createdAt   DateTime            @default(now())

  @@index([userId, purpose])
}

model AuditLog {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  actorUserId String?  @db.Uuid
  actor       User?    @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  action      String
  targetType  String?
  targetId    String?
  metadata    Json?
  ip          String?
  createdAt   DateTime @default(now())

  @@index([actorUserId, createdAt])
  @@index([targetType, targetId, createdAt])
}
