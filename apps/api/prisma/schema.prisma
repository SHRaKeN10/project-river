// Project River - database schema.
// Phase 1 establishes the auth + audit core. Phase 2 adds email verification /
// password reset tokens and links RefreshToken to Session (rotation family).
// Poker tables, hands, hand events and player statistics are added in Phase 5.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  PLAYER
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  BANNED
  DELETED
}

enum VerificationPurpose {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

enum PokerGameType {
  NLHE
  /// Pot-Limit Omaha - four hole cards, exactly two play. Maps to the engine's
  /// GameVariant.Omaha (see apps/api/src/tables/game-variant.ts).
  PLO
  /// "Big O" - five-card Pot-Limit Omaha, eight-or-better hi/lo split. Maps to
  /// GameVariant.Omaha5HiLo. Fits at most eight seats (5 hole cards per deck).
  OMAHA5_HILO
}

enum PokerTableStatus {
  ACTIVE
  PAUSED
  CLOSED
}

enum TournamentStatus {
  /// Created; registration has not opened.
  SCHEDULED
  /// Open for registration (before the start and, later, during late reg).
  REGISTERING
  RUNNING
  PAUSED
  FINISHED
  CANCELLED
}

model User {
  id             String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email          String     @unique
  username       String     @unique
  passwordHash   String
  role           UserRole   @default(PLAYER)
  status         UserStatus @default(ACTIVE)
  avatarUrl      String?
  emailVerifiedAt DateTime?
  /// Free-to-play game currency. NOT money - no deposits/withdrawals. Refills
  /// via /api/chips/rebuy when depleted.
  playChips      Int        @default(10000)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  deletedAt      DateTime?

  sessions             Session[]
  refreshTokens        RefreshToken[]
  verificationTokens   VerificationToken[]
  auditLogs            AuditLog[]          @relation("AuditActor")
  tableSeats           PokerTableSeat[]
  tableFavorites       TableFavorite[]
  waitlistEntries      TableWaitlistEntry[]
  chipLedger           ChipLedgerEntry[]
  tournamentEntries    TournamentEntry[]

  @@index([status])
}

enum ChipMovementReason {
  SIGNUP_GRANT
  REBUY_GRANT
  TABLE_BUYIN
  TABLE_BUYIN_REFUND
  TABLE_CASHOUT
  TABLE_TIME_CHARGE
  TOURNAMENT_BUYIN
  TOURNAMENT_REFUND
  TOURNAMENT_PAYOUT
  ADJUSTMENT
}

/// Append-only record of every change to a player's `playChips`. Written in the
/// same transaction as the balance update. `idemKey` makes a retried movement
/// (e.g. a cash-out re-attempted after a DB blip) a safe no-op.
model ChipLedgerEntry {
  id           String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId       String             @db.Uuid
  user         User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Signed: negative leaves the wallet, positive returns to it.
  amount       Int
  reason       ChipMovementReason
  /// Wallet balance immediately after this entry.
  balanceAfter Int
  tableId      String?            @db.Uuid
  idemKey      String             @unique
  createdAt    DateTime           @default(now())

  @@index([userId, createdAt])
}

/// A cash-game table. The live hand state lives in memory in the table's
/// TableRunner; this row is the durable config + current seat/stack roster
/// (written back after every hand) so a table survives an API restart.
model PokerTable {
  id         String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name       String
  gameType   PokerGameType    @default(NLHE)
  smallBlind Int
  bigBlind   Int
  ante       Int              @default(0)
  maxSeats   Int              @default(9)
  minBuyIn   Int
  maxBuyIn   Int
  isPrivate  Boolean          @default(false)
  status     PokerTableStatus @default(ACTIVE)
  handNumber Int              @default(0)
  /// Flat per-seat time charge (membership-club billing, not a pot rake) -
  /// mirrors the model used by Texas card rooms like Texas Card House/Hijack.
  /// Billed against the player's chip *wallet* (ChipLedgerEntry, reason
  /// TABLE_TIME_CHARGE), never their on-table stack. 0 disables it (the
  /// table plays exactly as before).
  timeChargeAmount     Int @default(0)
  timeChargeIntervalMs Int @default(0)
  /// Last completed hand's positions, kept so the forward-moving big blind
  /// rotates correctly after a cold restart with no Redis snapshot. All null
  /// before the table's first hand.
  buttonSeat     Int?
  smallBlindSeat Int?
  bigBlindSeat   Int?
  /// Bomb pots (NLHE cash only - ADR-0026). When enabled, the next eligible
  /// hand after every `bombPotIntervalHands` completed hands is a bomb pot:
  /// every player posts `bombPotAmount` (0 = use the big blind) as dead money
  /// before the deal and there is no preflop betting. `handsSinceLastBomb` is
  /// the completed-hand counter, persisted here so a cold restart with no Redis
  /// snapshot cannot cause or skip a bomb pot (the warm path uses the snapshot).
  bombPotEnabled       Boolean @default(false)
  bombPotIntervalHands Int     @default(15)
  bombPotAmount        Int     @default(0)
  handsSinceLastBomb   Int     @default(0)
  /// Rolling stats for the lobby's "average pot" column.
  handsPlayed Int             @default(0)
  potSum     Int              @default(0)
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  seats     PokerTableSeat[]
  favorites TableFavorite[]
  waitlist  TableWaitlistEntry[]
  hands     PokerHand[]

  @@index([status])
}

/// One completed hand, persisted for dispute resolution and replay. Given the
/// same `deck` and `actions`, the engine's `replayHand` reproduces it exactly.
model PokerHand {
  id             String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tableId        String     @db.Uuid
  table          PokerTable @relation(fields: [tableId], references: [id], onDelete: Cascade)
  handNumber     Int
  /// The engine's hand id, to correlate with the live event stream / logs.
  engineHandId   String
  /// 52-card deal order (compact strings). The replay input.
  deck           Json
  buttonSeat     Int
  smallBlindSeat Int?
  bigBlindSeat   Int
  /// The prior hand's { buttonSeat, smallBlindSeat, bigBlindSeat } - the other
  /// input `replayHand` needs to reproduce blind assignment. null for hand 1.
  prevPositionsJson Json?
  /// [{ seat, userId, username, startStack }]
  seatsJson      Json
  /// Ordered PLAYER_ACTION / TIMEOUT sequence after START_HAND. The replay input.
  actionsJson    Json
  board          String[]
  /// [{ seat, userId, net, endStack }]
  resultsJson    Json
  potTotal       Int
  /// Per-player bomb-pot contribution if this hand was a bomb pot; 0 otherwise.
  /// `replayHand` needs it to reproduce a bomb-pot hand (no preflop betting).
  bombPotAmount  Int        @default(0)
  /// Denormalised for "my recent hands" lookups.
  userIds        String[]   @db.Uuid
  startedAt      DateTime
  endedAt        DateTime   @default(now())

  @@unique([tableId, handNumber])
  @@index([tableId, endedAt])
  @@index([userIds], type: Gin)
}

model TableFavorite {
  id        String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String     @db.Uuid
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  tableId   String     @db.Uuid
  table     PokerTable @relation(fields: [tableId], references: [id], onDelete: Cascade)
  createdAt DateTime   @default(now())

  @@unique([userId, tableId])
  @@index([userId])
}

model TableWaitlistEntry {
  id        String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tableId   String     @db.Uuid
  table     PokerTable @relation(fields: [tableId], references: [id], onDelete: Cascade)
  userId    String     @db.Uuid
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime   @default(now())

  @@unique([tableId, userId])
  @@index([tableId, createdAt])
}

model PokerTableSeat {
  id         String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tableId    String      @db.Uuid
  table      PokerTable  @relation(fields: [tableId], references: [id], onDelete: Cascade)
  seatNumber Int
  userId     String?     @db.Uuid
  user       User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  stack      Int         @default(0)
  sittingOut Boolean     @default(false)
  joinedAt   DateTime?
  updatedAt  DateTime    @updatedAt

  @@unique([tableId, seatNumber])
  @@index([userId])
}

/// A multi-table tournament. The live game (level clock, per-table runners,
/// seat balancing) lives in memory in the API's TournamentRunner; this row is
/// the durable config + clock bookmark + final results, so a tournament
/// survives an API restart.
model Tournament {
  id            String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name          String
  gameType      PokerGameType    @default(NLHE)
  status        TournamentStatus @default(SCHEDULED)
  /// Tournament chips added to the prize pool per entry (play money).
  buyIn         Int
  /// The house's fee per entry; not added to the pool. 0 = freeroll-style.
  entryFee      Int              @default(0)
  /// Tournament chips every entrant starts with.
  startingStack Int
  seatsPerTable Int              @default(9)
  /// The blind structure: an ordered BlindLevel[] (see @river/poker-engine).
  blindsJson    Json
  /// Registration closes when this level begins (1 = no late registration).
  lateRegUntilLevel Int          @default(1)
  maxEntrants   Int?
  /// Wall-clock start of the level timer; null until RUNNING.
  startedAt     DateTime?
  /// Total milliseconds the clock has been paused, so the level maths can
  /// subtract it from real elapsed time.
  pausedMs      Int              @default(0)
  /// When the current pause began; null unless PAUSED.
  pausedAt      DateTime?
  finishedAt    DateTime?
  /// Final standings once FINISHED: [{ userId, position, payout }].
  resultsJson   Json?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  entries       TournamentEntry[]

  @@index([status])
}

/// One player's registration in a tournament, and their live state while it runs.
model TournamentEntry {
  id             String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tournamentId   String     @db.Uuid
  tournament     Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  userId         String     @db.Uuid
  user           User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  registeredAt   DateTime   @default(now())
  /// The poker table + seat this entry is playing at; null before the seat draw
  /// and after elimination.
  seatTableId    String?    @db.Uuid
  seatNumber     Int?
  /// Tournament chips, updated after every completed hand.
  stack          Int        @default(0)
  eliminatedAt   DateTime?
  /// 1 = winner. Set on elimination, and for everyone once the tournament ends.
  finishPosition Int?
  payout         Int        @default(0)

  @@unique([tournamentId, userId])
  @@index([tournamentId])
  @@index([userId])
}

/// A device/browser login. Refresh tokens are grouped under a session (their
/// "rotation family"); revoking a session revokes every refresh token issued
/// under it. This is what "logout" and a future "log out other devices" act on.
model Session {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String    @db.Uuid
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  deviceId   String?
  userAgent  String?
  ip         String?
  lastSeenAt DateTime  @default(now())
  createdAt  DateTime  @default(now())
  revokedAt  DateTime?

  refreshTokens RefreshToken[]

  @@index([userId])
}

/// Opaque, single-use, rotated on every refresh. `tokenHash` is SHA-256 of the
/// raw token (the token itself carries 256 bits of entropy, so a slow hash
/// isn't needed here - unlike passwords). Presenting an already-revoked token
/// is treated as token theft: the whole session is revoked (see AuthService).
model RefreshToken {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId       String    @db.Uuid
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionId    String    @db.Uuid
  session      Session   @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  tokenHash    String    @unique
  expiresAt    DateTime
  revokedAt    DateTime?
  replacedById String?   @db.Uuid
  userAgent    String?
  ip           String?
  createdAt    DateTime  @default(now())

  @@index([userId])
  @@index([sessionId])
}

/// Single-use tokens for email verification and password reset. Same
/// hashed-opaque-token pattern as RefreshToken. No email is sent yet in
/// Phase 2 (see AuthService) - this models the storage/consumption side.
model VerificationToken {
  id          String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String              @db.Uuid
  user        User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  purpose     VerificationPurpose
  tokenHash   String              @unique
  expiresAt   DateTime
  consumedAt  DateTime?
  createdAt   DateTime            @default(now())

  @@index([userId, purpose])
}

model AuditLog {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  actorUserId String?  @db.Uuid
  actor       User?    @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  action      String
  targetType  String?
  targetId    String?
  metadata    Json?
  ip          String?
  createdAt   DateTime @default(now())

  @@index([actorUserId, createdAt])
  @@index([targetType, targetId, createdAt])
}
