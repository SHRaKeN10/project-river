# apps/api - copy to .env (git-ignored). Staging/prod values come from the platform.

NODE_ENV=development
PORT=3000

# Postgres - host port matches docker/docker-compose.yml (POSTGRES_PORT, default 5433)
DATABASE_URL=postgresql://river:river_dev_password@localhost:5433/river_dev?schema=public

# Redis - host port matches docker/docker-compose.yml (REDIS_PORT, default 6380)
REDIS_URL=redis://localhost:6380

# Auth (Phase 2) - generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=change_me_dev_access_secret_min16
JWT_REFRESH_SECRET=change_me_dev_refresh_secret_min16
JWT_ACCESS_TTL=600
JWT_REFRESH_TTL=2592000

# CORS - comma separated origins allowed to call the API / open a socket.
# REQUIRED when NODE_ENV=staging|production (boot fails without it).
CORS_ORIGINS=http://localhost:8081,http://localhost:19006

# Poker table timing / lifecycle (ms unless noted). Defaults shown.
# TABLE_ACTION_TIMEOUT_MS=25000
# TABLE_NEXT_HAND_DELAY_MS=4000
# TABLE_START_DELAY_MS=3000
# TABLE_DISCONNECT_GRACE_MS=10000
# TABLE_AWAY_MAX_MS=120000            # stand a disconnected player up after this
# TABLE_AWAY_MAX_MISSED_HANDS=10      # ...or this many missed hands, whichever first
