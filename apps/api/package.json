    "@river/poker-engine": "workspace:*",
    "@river/shared-types": "workspace:*",
    "@socket.io/redis-adapter": "^8.3.0",
    "argon2": "^0.41.1",
    "ioredis": "^5.4.1",
    "nestjs-pino": "^4.1.0",
    "pino-http": "^10.3.0",
