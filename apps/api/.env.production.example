# apps/api - production environment. On Fly these are `fly secrets set` (secret)
# or fly.toml [env] (non-secret). Never commit real values.

# --- set by fly.toml [env] ---
NODE_ENV=production
PORT=3000

# --- set by `fly postgres attach` ---
DATABASE_URL=postgres://...@project-river-db.flycast:5432/project_river?sslmode=disable

# --- `fly redis create` prints this; then `fly secrets set REDIS_URL=...` ---
# Must be rediss:// (TLS) for Upstash. ioredis picks up TLS from the scheme.
REDIS_URL=rediss://default:...@fly-project-river.upstash.io:6379

# --- `fly secrets set` — generate each with:
#     node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Access-token lifetime (s) / refresh-token lifetime (s). Defaults are fine.
JWT_ACCESS_TTL=600
JWT_REFRESH_TTL=2592000

# --- REQUIRED in production (boot fails if empty) ---
# The native app sends no Origin header, so this only matters for a future
# browser client. Set it to the API's own URL for now.
CORS_ORIGINS=https://project-river.fly.dev

# --- optional table tuning (ms unless noted); omit to use defaults ---
# TABLE_ACTION_TIMEOUT_MS=25000
# TABLE_NEXT_HAND_DELAY_MS=4000
# TABLE_START_DELAY_MS=3000
# TABLE_DISCONNECT_GRACE_MS=10000
# TABLE_AWAY_MAX_MS=120000
# TABLE_AWAY_MAX_MISSED_HANDS=10
