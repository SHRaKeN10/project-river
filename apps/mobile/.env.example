# apps/mobile - copy to .env (git-ignored). Expo inlines EXPO_PUBLIC_* at bundle time.

# Where the app talks to. On a real device `localhost` is the phone, so for the
# alpha point this at the deployed API. Same host for REST and the socket.
EXPO_PUBLIC_API_URL=https://project-river.fly.dev

# Optional: only if the socket lives somewhere else. Defaults to EXPO_PUBLIC_API_URL.
# EXPO_PUBLIC_SOCKET_URL=
