{
  "name": "@river/mobile",
  "version": "0.0.0",
  "private": true,
  "license": "UNLICENSED",
  "main": "index.ts",
  "scripts": {
    "dev": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint . --ext .ts,.tsx --max-warnings 0",
    "test": "jest --forceExit"
  },
  "jest": {
    "preset": "jest-expo/ios",
    "setupFilesAfterEnv": [
      "<rootDir>/jest.setup.ts"
    ],
    "testMatch": [
      "<rootDir>/src/**/*.test.{ts,tsx}"
    ],
    "moduleNameMapper": {
      "^react$": "<rootDir>/../../node_modules/react",
      "^react/(.*)$": "<rootDir>/../../node_modules/react/$1",
      "^react-test-renderer$": "<rootDir>/../../node_modules/react-test-renderer",
      "^react-test-renderer/(.*)$": "<rootDir>/../../node_modules/react-test-renderer/$1",
      "^react-native$": "<rootDir>/../../node_modules/react-native",
      "^react-native/(.*)$": "<rootDir>/../../node_modules/react-native/$1"
    },
    "transformIgnorePatterns": [
      "node_modules/(?!(?:\\.pnpm/[^/]+/node_modules/)?(?:(jest-)?react-native|@react-native|@react-navigation|react-navigation|expo(nent)?|@expo|@expo-google-fonts|@sentry/react-native|native-base|react-native-.*|@river|@testing-library))"
    ]
  },
  "dependencies": {
    "@expo/metro-runtime": "~57.0.15",
    "@react-navigation/native": "^7.3.18",
    "@react-navigation/native-stack": "^7.18.10",
    "@river/shared-types": "workspace:*",
    "@tanstack/react-query": "^5.59.0",
    "expo": "~57.0.19",
    "expo-constants": "~57.0.17",
    "expo-secure-store": "~57.0.3",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "5.7.0",
    "react-native-screens": "~4.26.2",
    "react-native-web": "~0.21.2",
    "socket.io-client": "^4.8.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.0",
    "@babel/runtime": "^7.25.0",
    "@expo/ngrok": "^4.1.0",
    "@river/config": "workspace:*",
    "@testing-library/react-native": "^13.3.3",
    "@types/react": "~19.2.0",
    "@types/react-test-renderer": "^19.1.0",
    "eslint": "^8.57.1",
    "jest": "^29.7.0",
    "jest-expo": "~57.0.5",
    "react-server-dom-webpack": "~19.2.4",
    "react-test-renderer": "19.2.3",
    "typescript": "^5.6.2"
  }
}
