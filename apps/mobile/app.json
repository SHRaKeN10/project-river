{
  "expo": {
    "name": "Project River",
    "slug": "project-river",
    "scheme": "river",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "assetBundlePatterns": ["**/*"],
    "ios": {
