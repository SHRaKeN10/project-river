# ---------------------------------------------------------------------------
# Root env - consumed by docker/docker-compose.yml for local infrastructure.
# Copy to .env before running `pnpm infra:up`.
# Host ports are non-default to dodge collisions with other local services.
# ---------------------------------------------------------------------------

# PostgreSQL
POSTGRES_USER=river
POSTGRES_PASSWORD=river_dev_password
POSTGRES_DB=river_dev
POSTGRES_PORT=5433

# Redis
REDIS_PORT=6380

# Adminer (DB web UI) -> http://localhost:8091
ADMINER_PORT=8091
